{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pylume",
  "version": "0.1.0",
  "identifier": "com.pylume.shell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] },
      "dangerousDisableAssetCspModification": true
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./nsis/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../intel/target/release/pylume-intel.exe": "pylume-intel.exe",
      "../../probe/src/": "probe/src/",
      "../../vendor/debugpy/": "debugpy/"
    }
  }
}
