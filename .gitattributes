# 统一行尾：文本文件在仓库中以 LF 存储，检出时按平台转换。
# 这样 Windows / macOS / Linux 协作不会出现无意义的 diff，也消除
# "LF will be replaced by CRLF" 警告。

* text=auto eol=lf

# 强制按文本处理并规范行尾的源码类型
*.ts       text eol=lf
*.tsx      text eol=lf
*.js       text eol=lf
*.jsx      text eol=lf
*.mjs      text eol=lf
*.cjs      text eol=lf
*.json     text eol=lf
*.toml     text eol=lf
*.lock     text eol=lf
*.md       text eol=lf
*.rs       text eol=lf
*.py       text eol=lf
*.ps1      text eol=lf
*.xml      text eol=lf
*.nsi      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.svg      text eol=lf

# 二进制文件：禁止文本处理与行尾转换
*.png      binary
*.ico      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.eot      binary
*.pdf      binary
*.db       binary
*.sqlite   binary
*.exe      binary
*.dll      binary
*.pdb      binary
